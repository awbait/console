# Binaries
/portal
/bin/
*.exe
# Where air puts the binary it rebuilds (see .air.toml).
/tmp/

# Env / secrets
.env
*.pem
*.key

# Go
/vendor/

# Frontend
node_modules/
web/dist/
web/.vite/
web/*.tsbuildinfo
*.log

# Embedded SPA: only the placeholder is tracked; real assets are injected at
# image build time (see Dockerfile), never committed.
internal/spa/dist/*
!internal/spa/dist/index.html

# Helm packaging artifacts
*.tgz

# Python bytecode (skill scripts)
__pycache__/

# Editors / OS
.idea/
.vscode/
*.swp
.DS_Store

# Claude local settings (skills are tracked)
.claude/settings.local.json

# Playwright Agent CLI: browser workspace and per-run artifacts (snapshots,
# screenshots, traces, saved storage state). The skill itself is tracked.
# Unanchored: the CLI writes beside the working directory it was run from, so
# a session started in web/ leaves them there and not only in the repo root.
.playwright/
.playwright-cli/

# Docs: work in progress, not tracked for now
/docs/

# Separate charts repo dropped in here, tracked on its own
/charts/

# Local workspace with external charts and the console source mirror
/charts-ext/

# Scratch task materials (specs, screenshots, sample values)
/task/
