# Generated from internal/config: run "make env-example" after changing a
# variable, and do not edit this file by hand.
#
# Copy it to .env and adjust. Uncommented lines carry the value this example
# recommends; commented ones are optional, or only needed in a particular mode.
#
# The portal always talks to the real Harbor, GitLab and Argo CD and refuses to
# start without their addresses and tokens. The in-memory fakes next to each
# client are used by tests only and cannot be switched on from here.

# =============================================================================
# The portal itself
# =============================================================================
# Where the portal listens and how it is reached from outside.

# Port the portal serves its API and UI on.
HTTP_PORT=8080

# External address the portal is opened at.
PUBLIC_URL=http://localhost:8080

# Send the session cookie over HTTPS only. Turn it off only for a plain-HTTP
# stand that is not localhost.
COOKIE_SECURE=true

# =============================================================================
# Signing in
# =============================================================================
# Users sign in through an OIDC identity provider (Keycloak). AUTH_MODE has one
# runtime value: the no-Keycloak mode is a test stub and is rejected at
# startup.

# How users sign in. There is one runtime mode: through the identity provider.
# Possible values: oidc.
AUTH_MODE=oidc

# Realm address of the identity provider. Must match the issuer its tokens
# carry, which is host-sensitive.
# OIDC_ISSUER=http://localhost:8081/realms/internal

# Identifier of the portal as a client of the identity provider.
# OIDC_CLIENT_ID=portal

# Secret of that client.
# OIDC_CLIENT_SECRET=portal-secret

# Address the browser is returned to after signing in. Must be allowed in the
# realm.
# OIDC_REDIRECT_URL=http://localhost:8080/api/v1/auth/callback

# Where the browser goes after a successful sign-in.
OIDC_POST_LOGIN_REDIRECT=/

# Where the browser goes after signing out. Must be registered as a post-logout
# address on the client; empty reuses the sign-in one.
# OIDC_POST_LOGOUT_REDIRECT=http://localhost:5173/

# What the portal asks the identity provider about the user. Groups are what
# roles and teams are built from.
OIDC_SCOPES=openid,profile,email,groups

# Key the session is encrypted with. The portal refuses to start while it is
# still this one.
SESSION_SECRET=dev-insecure-session-secret-change-me

# Name of the cookie the session is kept in.
SESSION_COOKIE_NAME=idp_session

# How long a session lives without signing in again.
SESSION_TTL=24h

# =============================================================================
# Roles and teams
# =============================================================================
# Roles and teams are derived from the group claims of the identity provider.
#
# The team prefix is matched against every segment of a group path, so a
# prefixed segment anywhere resolves: /group/group/team-core/group gives the
# team core. The admin, support and security groups are matched by the full
# path with the leading slash stripped, so platform-admins matches
# /platform-admins but not a nested /x/platform-admins/y. A subgroup cannot
# escalate into a privileged role.

# Groups granting the platform administrator role. Empty means nobody has it.
# RBAC_ADMIN_GROUPS=platform-admins

# Groups granting the support role: the orders of every team, without creating
# or deleting them.
# RBAC_SUPPORT_GROUPS=support

# Groups granting the information security role: the security section and
# policy orders.
# RBAC_SECURITY_GROUPS=security

# Prefix marking the groups a user's teams are taken from.
RBAC_TEAM_GROUP_PREFIX=team-

# Expression whose first capture group is the team name. When set it is used
# instead of the prefix.
# RBAC_TEAM_GROUP_REGEX=(?:^|/)team-([^/]+)

# =============================================================================
# Harbor, the chart registry
# =============================================================================
# Where the portal takes charts, their versions and their order forms from.
# Required: the portal does not start without it.

# Address of Harbor, without the API suffix. Required.
HARBOR_URL=https://host.docker.internal:8084

# Robot account the portal reads charts as. Empty reads them anonymously, which
# only works for public projects.
# HARBOR_ROBOT_USER=

# Password of that robot account.
# HARBOR_ROBOT_TOKEN=

# Harbor projects the catalog is built from.
HARBOR_PROJECTS=platform,managed-services

# Shared secret authenticating notifications from Harbor. Set the same value as
# the webhook auth header there; empty leaves the portal to find new charts by
# polling.
# HARBOR_WEBHOOK_SECRET=

# Skip verification of the Harbor certificate. For stands with a self-signed
# one.
HARBOR_INSECURE_TLS=false

# How long to wait for a Harbor response.
HARBOR_TIMEOUT=30s

# Registry the order manifest points at as the source of its chart. This is the
# Harbor OCI endpoint.
# CHART_REGISTRY=host.docker.internal:8084

# =============================================================================
# GitLab
# =============================================================================
# Holds the GitOps repositories of the teams and the merge requests orders
# travel through. Required.

# Address of GitLab. Required.
GITLAB_URL=http://localhost:8929

# Token the portal creates repositories and merge requests with. Needs the api
# scope, and the Owner role on the GitOps group if it is to create team
# subgroups too. Required.
GITLAB_TOKEN=glpat-localdev0123456789abcd

# How long to wait for a GitLab response.
GITLAB_TIMEOUT=30s

# Merge the portal's own merge requests without waiting for a human. A service
# whose version asks for a review is merged by a person even so, and no service
# can merge itself where this is off.
GITLAB_AUTO_MERGE=false

# Top-level group the GitOps repositories live in.
GITLAB_GITOPS_GROUP=managed-services

# Template for a team's subgroup path inside that group.
GITLAB_TEAM_SUBGROUP_TEMPLATE=team-{{.Team}}

# Create a team's subgroup on the first order when it is missing. Turn it off
# where subgroups are provisioned elsewhere: then a team without one cannot
# order until somebody creates it. Creating a subgroup needs the token to own
# the top-level group.
GITLAB_CREATE_TEAM_SUBGROUP=true

# Branch order changes are merged into and Argo CD tracks.
GITLAB_DEFAULT_BRANCH=main

# Secret verifying notifications from GitLab. Set the same value as the webhook
# secret token there; empty leaves the portal to find merges by polling.
# GITLAB_WEBHOOK_TOKEN=

# Address GitLab delivers notifications to, as seen from GitLab itself. Setting
# it lets the portal register the webhook on its own, including on repositories
# it creates later; empty means somebody registers it by hand.
# GITLAB_WEBHOOK_URL=http://host.docker.internal:8080/api/v1/webhooks/gitlab

# Where that webhook is registered: on the whole group (needs GitLab Premium),
# on the whole instance (needs an administrator token), on each repository, or
# whichever of those the instance allows. Possible values: auto, group, system,
# project.
GITLAB_WEBHOOK_SCOPE=auto

# =============================================================================
# Argo CD
# =============================================================================
# Deploys what the portal commits and reports the state of it back. Required.

# Address of Argo CD. Required.
ARGOCD_URL=http://localhost:8083

# Token the portal reads application state with. On the stand, mint one with
# make stand-token. Required.
ARGOCD_TOKEN=

# Argo CD project the portal's applications belong to.
ARGOCD_PROJECT=portal-managed

# Namespace Argo CD runs in. The portal writes it into every application.yaml
# it commits, because Argo CD only picks up applications from its own
# namespace.
ARGOCD_NAMESPACE=argocd

# Cluster orders are deployed to unless they say otherwise.
ARGOCD_DEFAULT_CLUSTER=in-cluster

# Template for the name of the generated Argo CD application. Knows the team,
# the chart and the service name.
ARGOCD_APP_NAME_TEMPLATE={{.Team}}-{{.Chart}}-{{.ServiceName}}

# =============================================================================
# Storage
# =============================================================================
# Memory needs no infrastructure and is lost on restart; postgres and redis
# need the connections below.

# Where orders, publications and categories are kept. Possible values:
# postgres, memory.
STORE=memory

# Where cached chart files are kept. Possible values: redis, memory.
CACHE=memory

# Connection to the portal database. Required when the store is postgres.
# DATABASE_URL=postgres://portal:portal@localhost:5432/portal?sslmode=disable

# How many database connections may be open at once.
DATABASE_MAX_CONNS=20

# Connection to the cache. Required when the cache is redis.
# REDIS_URL=redis://localhost:6379/0

# =============================================================================
# Keeping state fresh
# =============================================================================
# hybrid: a periodic reconcile plus notifications from GitLab and Harbor that
# trigger an immediate sweep, with the poll left on as a safety net. Without
# the webhook secrets set this is polling alone, which is the right local
# behaviour.
#
# webhook: notifications only, no periodic poll. A startup sweep still runs,
# but a notification that never arrives is not retried until the next restart,
# so use this only where delivery is reliable. Needs GITLAB_WEBHOOK_TOKEN.

# How the portal learns about changes: by polling with notifications on top, or
# by notifications alone. Possible values: hybrid, webhook.
STATUS_UPDATE_MODE=hybrid

# How often the portal reconciles orders against GitLab and Argo CD. Raise it
# once notifications are wired.
STATUS_POLL_INTERVAL=15s

# Flag orders whose committed files were changed in Git outside the portal.
# Reads Git, never writes it.
DRIFT_DETECTION_ENABLED=true

# Adopt manifests created directly in Git, bypassing the portal, as imported
# orders.
IMPORT_DISCOVERY_ENABLED=false

# Register charts found in the registry as draft publications, so they can be
# curated into the catalog.
CATALOG_AUTODISCOVER=false

# =============================================================================
# Logs and metrics
# =============================================================================
# What the portal writes about itself.

# Separate port for Prometheus metrics, kept off the public ingress.
METRICS_PORT=2112

# Base address of Grafana. When set, the status page links to it; empty hides
# the link.
# GRAFANA_URL=http://localhost:3000

# How much detail the log carries. Possible values: debug, info, warn, error.
LOG_LEVEL=info

# Log format: machine-readable json or readable text. Possible values: json,
# text.
LOG_FORMAT=json
