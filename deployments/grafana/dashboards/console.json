        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (verdict) (console_config_checks)",
          "legendFormat": "{{verdict}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "People",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 63 },
      "id": 22,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "People here now",
      "description": "Anyone whose browser has asked the portal for something in the last five minutes. The portal is never told that somebody left, so presence is always \"seen recently\". Who they are is on the portal's own page (Админ -> Активность): names stay behind the sign-in, because this endpoint is scraped without one.",
