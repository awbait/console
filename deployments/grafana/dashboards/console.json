    {
      "type": "row",
      "title": "Provisioning (merge & sync)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 37 },
      "id": 15
    },
    {
      "type": "timeseries",
      "title": "MR auto-merge rate (by result)",
      "description": "Auto-merge attempts on the portal's own MRs. Errors here are races the next tick clears (a sibling order merged first); an order that will never merge on its own is counted on the panel beside this one instead.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 38 },
      "id": 16,
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" },
