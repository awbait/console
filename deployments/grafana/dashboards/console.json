          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Orders wedged on merge (by reason)",
      "description": "Orders whose change GitLab will not merge as it stands, counted once each with GitLab's reason (conflict, need_rebase, ci_must_pass, not_approved, ...). Every sample is an order stopped until a person resolves it - anything above zero deserves a look.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 46 },
      "id": 18,
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (reason) (increase(console_mr_merge_blocked_total[$__range]))",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Configuration checks",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 54 },
      "id": 19
    },
    {
      "type": "stat",
      "title": "Checks failing (by component)",
      "description": "A failing configuration check means the portal is not wired to that system the way it thinks it is: a token without the scope it needs, a webhook nobody registered on the other side, a project or cluster that is not there. Which check it is shows on the portal's configuration page and in the log (component=checks). The set runs every 10 minutes, so this moves slowly by design.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 55 },
      "id": 20,
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (component) (console_config_checks{verdict=\"fail\"})",
          "legendFormat": "{{component}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Configuration checks by verdict",
      "description": "skip is a setting deliberately left off; unknown is a check that could not look, because the upstream did not answer or does not expose what the check needed.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 55 },
      "id": 21,
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
