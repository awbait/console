# Line endings: LF in the repository and in every checkout, on every platform.
# core.autocrlf=true on Windows would otherwise check text files out as CRLF,
# which breaks byte-for-byte checks: the Atlas checksum of the embedded
# migrations (atlas.sum), .env.example compared with its generator, and chart
# packages built from a checkout (see .claude/rules/stand.md).
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Byte-for-byte checked files, pinned explicitly even if the rule above changes.
# The portal embeds the migrations via go:embed and validates the Atlas checksum
# at startup; a CRLF checkout fails with "validate migrations: checksum mismatch".
internal/store/migrations/*.sql text eol=lf
internal/store/migrations/atlas.sum text eol=lf
# Generated by `make env-example` and compared with the generator by
# TestEnvExampleGenerated.
.env.example text eol=lf

# Generated and vendored files: collapsed in diffs and excluded from language
# statistics.
bun.lock linguist-generated=true
.agents/skills/ui-ux-pro-max/data/** linguist-generated=true

# Binary assets: never touch line endings, never diff as text.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.zip binary
*.tgz binary
*.pdf binary
